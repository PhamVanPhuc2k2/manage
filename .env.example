# ---------- Chung ----------
COMPOSE_PROJECT_NAME=manage
ENV=development
LOG_LEVEL=debug

# ---------- PostgreSQL ----------
POSTGRES_USER=manage
POSTGRES_PASSWORD=manage_dev_password
POSTGRES_DB=manage
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PASSWORD=redis_dev_password
REDIS_PORT=6379

# ---------- RabbitMQ ----------
RABBITMQ_USER=manage
RABBITMQ_PASSWORD=rabbit_dev_password
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# ---------- Cloudflare R2 (lưu trữ tệp) ----------
# Lấy tại: Cloudflare Dashboard > R2 > Manage R2 API Tokens
#
# R2 tương thích S3 nhưng khác AWS ở hai điểm bắt buộc phải đúng:
#   - Region luôn là "auto", không phải tên vùng địa lý
#   - Địa chỉ có dạng https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#
# Để trống thì hệ thống vẫn chạy bình thường, chỉ riêng chức năng tải tệp
# lên báo lỗi rõ ràng — tiện khi phát triển phần không liên quan tới tệp.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=manage-dev

# Tên miền công khai của bucket, nếu có bật.
# Để trống thì hệ thống sinh presigned URL có hạn 1 giờ cho mỗi lần xem.
R2_PUBLIC_URL=

# ---------- JWT ----------
# Sinh bằng: openssl rand -base64 48
JWT_SECRET=doi_chuoi_nay_truoc_khi_len_production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ---------- Mã xác minh đăng nhập (OTP) ----------
# Bật: sau khi nhập đúng mật khẩu, hệ thống gửi mã 6 chữ số qua email và chỉ
# cấp token khi nhập đúng mã. Mã sống 5 phút, sai 5 lần là huỷ thử thách.
#
# Ở dev, mã nằm trong MailHog: http://localhost:8025
#
# Chỉ đặt false khi SMTP chết và cần cứu hoả, hoặc khi chạy kiểm thử tự động.
# Tắt nghĩa là ai có mật khẩu là vào được — đúng thứ OTP sinh ra để chặn.
AUTH_OTP_ENABLED=true

# ---------- Cổng expose ra host (chỉ dev) ----------
# Nếu port nào bị chiếm trên máy bạn (IIS, Laravel Herd, XAMPP hay chạy
# dự án khác), đổi số ở đây là đủ — không phải sửa file nào khác.
NGINX_PORT=80
API_PORT=8080
FRONTEND_PORT=3000
ADMINER_PORT=8081
MAILHOG_UI_PORT=8025

# ---------- Địa chỉ công khai ----------
# Địa chỉ trình duyệt dùng để vào hệ thống. Phải KHỚP với NGINX_PORT ở trên.
# Cổng 80 thì bỏ số cổng đi (trình duyệt gửi Origin không kèm ":80",
# ghi thừa sẽ làm CORS chặn request).
#   NGINX_PORT=80    →  PUBLIC_BASE_URL=http://localhost
#   NGINX_PORT=8088  →  PUBLIC_BASE_URL=http://localhost:8088
PUBLIC_BASE_URL=http://localhost
PUBLIC_WS_URL=ws://localhost

# ---------------------------------------------------------------- Giám sát
# Chỉ dùng khi bật docker-compose.monitoring.yml.
#
# Grafana là cửa DUY NHẤT vào toàn bộ dữ liệu vận hành, gồm cả log có thể
# chứa thông tin nhạy cảm. Đổi mật khẩu này trước khi mở cổng ra ngoài.
GRAFANA_USER=admin
GRAFANA_PASSWORD=doi-mat-khau-nay
GRAFANA_PORT=3001

# ------------------------------------------------------------ Gọi video
# Khoá của máy chủ media LiveKit. Để TRỐNG thì chức năng gọi tắt, phần
# còn lại của hệ thống vẫn chạy bình thường.
#
# KHÔNG dùng cặp mẫu "devkey/secret" mà tài liệu LiveKit hay dần: ai
# cũng biết nó, và biết nó là tự ký được token vào MỌI phòng họp.
# Sinh bộ mới:  openssl rand -hex 32
LIVEKIT_API_KEY=APIdevkey-doi-di
LIVEKIT_API_SECRET=doi-bi-mat-nay-bang-openssl-rand-hex-32

# Địa chỉ trình duyệt dùng để nối vào LiveKit. Phải là địa chỉ NGƯỜI
# DÙNG nhìn thấy, không phải tên máy trong mạng Docker — trình duyệt
# không phân giải được "livekit". Ở production phải là wss:// (getUserMedia
# chỉ chạy trên HTTPS, trừ localhost).
LIVEKIT_PUBLIC_URL=ws://localhost:7880

LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
TURN_UDP_PORT=3478

# STUN chỉ giúp máy biết địa chỉ công khai của chính nó, dùng cho đường
# P2P của gọi 1-1. Ở production nên trỏ vào STUN của công ty: mỗi lần
# gọi là một lần lộ IP nhân viên cho bên thứ ba.
STUN_URLS=stun:stun.l.google.com:19302

# TURN RIÊNG (coturn) — chỉ điền khi đã dựng một coturn tách khỏi LiveKit.
# Để trống thì gọi 1-1 không đục được NAT sẽ tự rơi về SFU, và TURN
# tích hợp của LiveKit lo nốt phần còn lại.
# TURN_SECRET phải trùng với static-auth-secret của coturn.
TURN_URLS=
TURN_SECRET=
