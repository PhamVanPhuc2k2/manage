*.test
coverage.out

# Node
node_modules/
.next/
out/

# Kho gói của pnpm.
#
# Nếu chạy `pnpm install` trong container mà không đặt store-dir, pnpm sẽ tạo
# thư mục này NGAY TRONG thư mục dự án — 1.3GB và hơn 20.000 file. Dòng dưới
# chặn nó lọt vào git; docker-compose.override.yml gắn một named volume vào
# đúng đường dẫn này để nó không rơi ra máy host nữa.
.pnpm-store/

# Bộ nhớ đệm của tsc. Sinh ra mỗi lần chạy `tsc --noEmit` để kiểm tra kiểu,
# nội dung là đường dẫn tuyệt đối trong container — vô nghĩa với máy khác.
tsconfig.tsbuildinfo

# Môi trường — KHÔNG BAO GIỜ commit
.env
.env.local
*.local

# Bản sao lưu database — KHÔNG BAO GIỜ commit
#
# scripts/backup.sh ghi vào đây theo mặc định. Một tệp dump chứa TOÀN BỘ
# hồ sơ nhân sự, bảng lương và tin nhắn nội bộ. Đẩy nhầm một lần là nó nằm
# trong lịch sử git vĩnh viễn, và xoá đi cũng không gỡ được khỏi các bản
# clone đã có.
backups/
*.dump

